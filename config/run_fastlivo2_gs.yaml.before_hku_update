setting:
  name: hku_landmark
  output_root: ./pings_experiments
  deskew: true
  color_channel: 3
  color_map_on: true
  deskew_ref_ratio: 1.0
process:
  min_range_m: 0.5
  max_range_m: 50.0
  min_z_m: -3.0
  vox_down_m: 0.08
sampler:
  surface_sample_range_m: 0.25
  surface_sample_n: 3
  free_sample_begin_ratio: 0.3
  free_front_sample_n: 2
neuralpoints:
  voxel_size_m: 0.2
  search_alpha: 0.8
  query_nn_k: 6
  feature_dim: 32
  color_feature_dim: 8
  weighted_first: true
decoder:
  freeze_after_frame: 30
  gs_mlp_hidden_dim: 128
loss:
  sigma_sigmoid_m: 0.08
  weight_color: 0.1
  loss_weight_on: true
  dist_weight_scale: 0.8
  ekional_loss_on: true
  weight_e: 0.5
gs:
  gs_type: gaussian_surfel
  exposure_correction_on: true
  learn_color_residual: true
  cam_pose_train_on: true
  view_concat_on: true
  gs_iters: 20
  gaussian_bs_ratio: 2.0
  img_pool_size: 20
  long_term_img_pool_size: 40
  nothing_new_count_thre: 10
  gs_down_rate: 1
  gs_vis_down_rate: 1
  lambda_depth: 0.02
  lambda_normal_depth: 0.01
  lambda_area: 1e-3
  lambda_opacity: 2e-3
  consist_shift_count: 0
  lambda_sdf_cons: 0.02
  lambda_sdf_normal_cons: 0.02
  lambda_sdf: 1.0
continual:
  batch_size_new_sample: 3000
  pool_capacity: 1e7
tracker:
  source_vox_down_m: 0.4
  iter_n: 50
pgo:
  map_context: true
  context_cosdist: 0.3
  min_loop_travel_ratio: 3.0
optimizer:
  iters: 15
  batch_size: 8192
eval:
  mesh_freq_frame: 10
  mesh_min_nn: 18
